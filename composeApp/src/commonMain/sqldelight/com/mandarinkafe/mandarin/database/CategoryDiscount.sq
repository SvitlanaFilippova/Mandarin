CREATE TABLE category_discount (
    categoryId TEXT NOT NULL PRIMARY KEY,
    discountId TEXT NOT NULL
);

selectAll:
SELECT * FROM category_discount;

selectDiscountByCategory:
SELECT discountId FROM category_discount
WHERE categoryId = ?;

deleteAll:
DELETE FROM category_discount;

insertOrReplace:
INSERT OR REPLACE INTO category_discount(categoryId, discountId)
VALUES (?, ?);

