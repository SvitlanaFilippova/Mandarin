<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/cartFragment">


    <fragment
        android:id="@+id/cartFragment"
        android:name="com.mandarinkafe.mandarin.cart.CartFragment"
        android:label="fragment_cart"
        tools:layout="@layout/fragment_cart" />


    <fragment
        android:id="@+id/mealDetails"
        android:name="com.mandarinkafe.mandarin.meal_customization.ui.EditMealBSFragment"
        android:label="fragment_meal_details"
        tools:layout="@layout/fragment_edit_meal">
        <argument
            android:name="meal"
            app:argType="string"
            app:nullable="false" />
        <action
            android:id="@+id/action_mealDetails_to_cartFragment"
            app:destination="@id/cartFragment" />
    </fragment>

    <fragment
        android:id="@+id/deliveryFragment"
        android:name="com.mandarinkafe.mandarin.delivery.DeliveryFragment"
        android:label="fragment_delivery"
        tools:layout="@layout/fragment_delivery">
        <action
            android:id="@+id/action_deliveryFragment_to_cartFragment"
            app:destination="@id/cartFragment" />
    </fragment>
    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.mandarinkafe.mandarin.favorites.FavoritesFragment"
        android:label="fragment_favorites"
        tools:layout="@layout/fragment_favorites" />

</navigation>