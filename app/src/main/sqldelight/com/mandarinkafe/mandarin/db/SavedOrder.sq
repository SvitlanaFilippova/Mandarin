CREATE TABLE saved_order (
    id TEXT NOT NULL PRIMARY KEY,
    whenCreated TEXT NOT NULL DEFAULT '',
    orderType TEXT NOT NULL DEFAULT '',
    addressLine1 TEXT NOT NULL DEFAULT '',
    addressDetails TEXT NOT NULL DEFAULT '',
    timestamp INTEGER NOT NULL,
    mealNames TEXT NOT NULL DEFAULT ''
);


selectAll:
SELECT * FROM saved_order
ORDER BY timestamp DESC;

insert:
INSERT INTO saved_order(id, whenCreated, orderType, addressLine1, addressDetails, timestamp, mealNames)
VALUES (?, ?, ?, ?, ?, ?, ?);
