CREATE TABLE CartItemEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    addsIds TEXT NOT NULL,
    modifiers TEXT NOT NULL,
    quantity INTEGER NOT NULL,
    comment TEXT
);

selectAll:
SELECT * FROM CartItemEntity;

selectById:
SELECT * FROM CartItemEntity WHERE id = ?;

insertOrReplace:
INSERT OR REPLACE INTO CartItemEntity(id, name, addsIds, modifiers, quantity, comment)
VALUES (?, ?, ?, ?,?,?);

deleteById:
DELETE FROM CartItemEntity WHERE id = ?;

